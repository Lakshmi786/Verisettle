# Real secret values - never commit.
# .env holds this machine's actual credentials; CREDENTIALS.md is the local
# listing of them. There is deliberately no .env.example: the env layout
# lives inside infra/scripts/generate-env.sh, so a fresh clone runs
# `make env` and gets its own secrets, and no env file is ever committed.
.env
.env.*
CREDENTIALS.md

# Rendered/bootstrapped files containing real secrets
infra/keycloak/realm-verisettle.json
.infisical-bootstrap.json
# Written by provision-infisical-identities.py: holds the clientSecret of
# every per-service machine identity. The script already calls it gitignored;
# it was not, and this repo is public.
.infisical-identities.json

# Locally vendored tooling (e.g. a pinned `infisical` CLI binary), not source.
/bin/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts

# Coding-assistant scratch files - not part of the project
CLAUDE.md
.claude/

# OS
.DS_Store

# Custodian - local development environment TEMPLATE.
#
# Do not copy this file by hand: the __RAND_HEX_n__ tokens below are
# placeholders, not values. Run
#
#     make env
#
# (or: sh infra/scripts/generate-env.sh) to write a .env with a freshly
# generated, working value for every local-only secret. Each token names
# the exact openssl call from SECRETS GEN GUIDE.md that produces it, so the
# guide, this template and the generator cannot drift apart.
#
# After generating, fill in the two real provider keys at the top.
# Values marked [AUTO-FILLED] are written by a setup script - leave blank.
# .env itself is gitignored and must never be committed.

# ----------------------------------------------------------------------
# 1. YOU MUST FILL THESE IN - the only two real external keys
# ----------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
# ----------------------------------------------------------------------
GROQ_API_KEY=gsk-replace-me
# 2. Compose / base
# ----------------------------------------------------------------------
COMPOSE_PROJECT_NAME=custodian
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__RAND_HEX_16__

PGPASS_KEYCLOAK=__RAND_HEX_16__
PGPASS_INFISICAL=__RAND_HEX_16__
PGPASS_LITELLM=__RAND_HEX_16__
PGPASS_MLFLOW=__RAND_HEX_16__
PGPASS_LANGFUSE=__RAND_HEX_16__
PGPASS_CUSTODIAN_LEDGER=__RAND_HEX_16__
PGPASS_CUSTODIAN_BACKEND=__RAND_HEX_16__

# MinIO root account
MINIO_ROOT_USER=custodian_admin___RAND_HEX_4__
MINIO_ROOT_PASSWORD=__RAND_HEX_16__

# ----------------------------------------------------------------------
# 3. Identity governance
# ----------------------------------------------------------------------
# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__RAND_HEX_16__
KEYCLOAK_BACKEND_CLIENT_SECRET=__RAND_HEX_16__
KEYCLOAK_CONSOLE_CLIENT_SECRET=__RAND_HEX_16__

# Demo users seeded into the realm
DEMO_AP_CLERK_PASSWORD=__RAND_HEX_8__
DEMO_CONTROLLER_PASSWORD=__RAND_HEX_8__
DEMO_CFO_PASSWORD=__RAND_HEX_8__

# SPIRE
SPIRE_TRUST_DOMAIN=custodian.local
# [AUTO-FILLED] by infra/scripts/setup-spire.sh
SPIRE_AGENT_JOIN_TOKEN=

# Infisical
INFISICAL_ADMIN_EMAIL=admin@custodian.local
INFISICAL_ADMIN_PASSWORD=__RAND_HEX_12__
INFISICAL_ADMIN_ORGANIZATION=Custodian
INFISICAL_ENCRYPTION_KEY=__RAND_HEX_16__
INFISICAL_AUTH_SECRET=__RAND_HEX_16__
# [AUTO-FILLED] by infra/scripts/bootstrap-infisical.sh
INFISICAL_ORG_ID=
# [AUTO-FILLED] by infra/scripts/provision-infisical-identities.py
INFISICAL_PROJECT_ID=
# [AUTO-FILLED] by infra/scripts/provision-infisical-identities.py
PAYMENT_EXECUTION_CLIENT_ID=
# [AUTO-FILLED] by infra/scripts/provision-infisical-identities.py
PAYMENT_EXECUTION_CLIENT_SECRET=

# ----------------------------------------------------------------------
# 4. Data governance
# ----------------------------------------------------------------------
OM_POSTGRES_ROOT_PASSWORD=__RAND_HEX_16__
AIRFLOW_ADMIN_PASSWORD=__RAND_HEX_12__
USASPENDING_AGENCY=Department of Health and Human Services
USASPENDING_FISCAL_YEAR=2024

# ----------------------------------------------------------------------
# 5. Model governance
# ----------------------------------------------------------------------
# LiteLLM master key
LITELLM_MASTER_KEY=sk-custodian-master-__RAND_HEX_16__
# [AUTO-FILLED] by infra/scripts/provision-litellm-keys.py
LITELLM_KEY_AGENT_EXTRACTION=
# [AUTO-FILLED] by infra/scripts/provision-litellm-keys.py
LITELLM_KEY_AGENT_RISK_SCORING=
# [AUTO-FILLED] by infra/scripts/provision-litellm-keys.py
LITELLM_KEY_AGENT_APPROVAL=
# [AUTO-FILLED] by infra/scripts/provision-litellm-keys.py
LITELLM_KEY_AGENT_PAYMENT_EXECUTION=
# [AUTO-FILLED] by infra/scripts/provision-litellm-keys.py (falls back to LITELLM_MASTER_KEY)
LITELLM_EXTRACTION_KEY=

# ----------------------------------------------------------------------
# 6. Application services
# ----------------------------------------------------------------------
LEDGER_API_KEY=ldg-__RAND_HEX_16__
VENDOR_LOOKUP_API_KEY=vlk-__RAND_HEX_16__
SETTLEMENT_HOLD_SECONDS=20
CONSOLE_NEXTAUTH_SECRET=__RAND_HEX_32__

# ----------------------------------------------------------------------
# 7. Operations / observability
# ----------------------------------------------------------------------
LANGFUSE_SALT=__RAND_HEX_32__
LANGFUSE_ENCRYPTION_KEY=__RAND_HEX_32__
LANGFUSE_NEXTAUTH_SECRET=__RAND_HEX_32__
LANGFUSE_CLICKHOUSE_PASSWORD=__RAND_HEX_16__
LANGFUSE_REDIS_AUTH=__RAND_HEX_16__
LANGFUSE_INIT_USER_PASSWORD=__RAND_HEX_12__
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-__RAND_HEX_16__
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-__RAND_HEX_16__

# Grafana admin
GRAFANA_ADMIN_PASSWORD=__RAND_HEX_12__
